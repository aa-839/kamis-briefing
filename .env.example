# KAMIS Open API (kamis.or.kr에서 발급)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 브리핑 문장을 쓸 LLM. '회사:모델' 형식. 이 줄만 바꾸면 모델이 바뀐다
# 예) openai:gpt-4.1-mini, openai:gpt-5.4-mini, anthropic:claude-sonnet-5-5
BRIEF_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# (선택) 가격 변동 원인 찾기용 뉴스 검색. 없으면 원인 없이 발행
EXA_API_KEY=

# (선택) LangSmith에서 작성→검증→재작성 과정을 단계별로 보기
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=kamis-briefing
LANGSMITH_API_KEY=
